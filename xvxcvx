-- CRASH-PROOF HARDWARE NAVIGATIONAL INPUT PROCESSING
--------------------------------------------------------------
local mouseWasDown = false

game:GetService("RunService").RenderStepped:Connect(function()
    -- Pull hardware coordinates safely utilizing WorldToScreen fallback configurations
    local mouseX, mouseY = 0, 0
    if typeof(WorldToScreen) == "function" then
        local projected, _ = WorldToScreen(Vector3.new(0, 0, 0))
        if projected then
            mouseX, mouseY = projected.X, projected.Y
        end
    end

    -- Evaluate absolute click parameters natively via external system hooks
    local leftClicked = false
    if typeof(ismouse1pressed) == "function" then
        local currentState = ismouse1pressed()
        if currentState and not mouseWasDown then
            leftClicked = true
        end
        mouseWasDown = currentState
    end

    -- Process Tab selection clicks
    if leftClicked then
        for name, assets in pairs(RenderedTabs) do
            local cfg = assets.Config
            local tX = MenuX + cfg.X
            local tY = MenuY + 12
            if mouseX >= tX and mouseX <= (tX + cfg.Width) and mouseY >= tY and mouseY <= (tY + 24) then
                ActiveTab = name
                leftClicked = false -- Consume click
                break
            end
        end
    end

    -- Process Checkbox toggle clicks inside active submenus
    if leftClicked then
        local currentItems = Features[ActiveTab]
        if currentItems then
            for idx, data in ipairs(currentItems) do
                local rowY = MenuY + HeaderHeight + 20 + ((idx - 1) * 32)
                -- Expand click bounds to encompass the text label for comfortable use
                if mouseX >= (MenuX + 20) and mouseX <= (MenuX + 300) and mouseY >= rowY and mouseY <= (rowY + 18) then
                    Toggles[data.Key] = not Toggles[data.Key]
                    break
                end
            end
        end
    end

    -- Refresh display elements seamlessly on frame updates
    updateInterfacePositions()
end)

