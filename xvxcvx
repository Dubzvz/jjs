-- UI DRAWING GENERATION FACTORY
--------------------------------------------------------------
local function createRenderObject(type, properties)
    local obj = SafeDrawing.new(type)
    if properties then
        for prop, val in pairs(properties) do
            pcall(function() obj[prop] = val end)
        end
    end
    table.insert(_G.DrawingObjects, obj)
    return obj
end

-- 1. Outer Dark Frame Background
local BaseBg = createRenderObject("Square", {
    Filled = true, Color = Color3.fromRGB(13, 13, 18), Visible = true
})

-- 2. Sleek Purple Border Stroke Outline (Inspired by image_1aafaa.png)
local OuterBorder = createRenderObject("Square", {
    Filled = false, Color = Color3.fromRGB(130, 75, 240), Thickness = 1.5, Visible = true
})

-- 3. Dynamic Top Header Divider Line
local TopDivider = createRenderObject("Line", {
    Color = Color3.fromRGB(25, 25, 35), Thickness = 1.5, Visible = true
})

-- 4. Reusable Tab Assets Cache
local RenderedTabs = {}
for i, tab in ipairs(Tabs) do
    local tabBox = createRenderObject("Square", {
        Filled = true, Color = Color3.fromRGB(22, 22, 30), Visible = true
    })
    local tabLine = createRenderObject("Line", {
        Color = Color3.fromRGB(130, 75, 240), Thickness = 2, Visible = false
    })
    local tabTxt = createRenderObject("Text", {
        Text = tab.Name, Size = 12, Center = true, Outline = true, Visible = true
    })
    RenderedTabs[tab.Name] = { Box = tabBox, Line = tabLine, Text = tabTxt, Config = tab }
end

-- 5. Main Functional Interactive Elements Cache
local RenderedFeatures = {}
for i = 1, 6 do
    local chkBox = createRenderObject("Square", {
        Filled = false, Color = Color3.fromRGB(55, 55, 70), Thickness = 1.5, Visible = false
    })
    local chkFill = createRenderObject("Square", {
        Filled = true, Color = Color3.fromRGB(130, 75, 240), Visible = false
    })
    local fText = createRenderObject("Text", {
        Text = "", Size = 13, Center = false, Outline = true, Color = Color3.fromRGB(190, 190, 200), Visible = false
    })
    table.insert(RenderedFeatures, { Box = chkBox, Fill = chkFill, Text = fText })
end

-- Static lines for empty configuration views
local UtilityStaticText = createRenderObject("Text", {
    Text = "", Size = 13, Center = false, Outline = true, Color = Color3.fromRGB(150, 150, 160), Visible = false
})

--------------------------------------------------------------
-- DYNAMIC COORDINATE RE-POSITIONING AND RENDER ENGINE
--------------------------------------------------------------
local function updateInterfacePositions()
    BaseBg.Position = Vector2.new(MenuX, MenuY)
    BaseBg.Size = Vector2.new(Width, Height)

    OuterBorder.Position = Vector2.new(MenuX, MenuY)
    OuterBorder.Size = Vector2.new(Width, Height)

    TopDivider.From = Vector2.new(MenuX, MenuY + HeaderHeight)
    TopDivider.To = Vector2.new(MenuX + Width, MenuY + HeaderHeight)

    -- Update Tab layouts dynamically
    for name, assets in pairs(RenderedTabs) do
        local cfg = assets.Config
        local tX = MenuX + cfg.X
        local tY = MenuY + 12
        
        assets.Box.Position = Vector2.new(tX, tY)
        assets.Box.Size = Vector2.new(cfg.Width, 24)
        
        assets.Text.Position = Vector2.new(tX + (cfg.Width / 2), tY + 5)
        
        assets.Line.From = Vector2.new(tX, tY + 24)
        assets.Line.To = Vector2.new(tX + cfg.Width, tY + 24)
        
        if name == ActiveTab then
            assets.Box.Color = Color3.fromRGB(26, 20, 38)
            assets.Text.Color = Color3.fromRGB(230, 210, 255)
            assets.Line.Visible = true
        else
            assets.Box.Color = Color3.fromRGB(20, 20, 26)
            assets.Text.Color = Color3.fromRGB(130, 130, 140)
            assets.Line.Visible = false
        end
    end

    -- Hide all content modules initially prior to sorting execution loops
    for _, item in ipairs(RenderedFeatures) do
        item.Box.Visible = false
        item.Fill.Visible = false
        item.Text.Visible = false
    end
    UtilityStaticText.Visible = false

    -- Mount features based on active tabs
    local currentItems = Features[ActiveTab]
    if currentItems then
        for idx, data in ipairs(currentItems) do
            local itemElements = RenderedFeatures[idx]
            if itemElements then
                local rowY = MenuY + HeaderHeight + 20 + ((idx - 1) * 32)
                
                -- Align custom checkboxes
                itemElements.Box.Position = Vector2.new(MenuX + 25, rowY)
                itemElements.Box.Size = Vector2.new(14, 14)
                itemElements.Box.Color = Toggles[data.Key] and Color3.fromRGB(130, 75, 240) or Color3.fromRGB(55, 55, 70)
                itemElements.Box.Visible = true
                
                itemElements.Fill.Position = Vector2.new(MenuX + 28, rowY + 3)
                itemElements.Fill.Size = Vector2.new(8, 8)
                itemElements.Fill.Visible = Toggles[data.Key]
                
                -- Text configurations
                itemElements.Text.Text = data.Label
                itemElements.Text.Position = Vector2.new(MenuX + 50, rowY - 1)
                itemElements.Text.Color = Toggles[data.Key] and Color3.fromRGB(230, 220, 255) or Color3.fromRGB(180, 180, 190)
                itemElements.Text.Visible = true
            end
        end
    elseif ActiveTab == "SETTINGS" then
        UtilityStaticText.Text = "⚡ Control Configuration:\nHotkeys: Use function keys [F1 - F8] for direct binds.\nPress [F1] to instantly hide this vector status interface."
        UtilityStaticText.Position = Vector2.new(MenuX + 25, MenuY + HeaderHeight + 25)
        UtilityStaticText.Visible = true
    elseif ActiveTab == "ABOUT" then
        UtilityStaticText.Text = "⚡ JJS Premium Vector Overlay\nEnvironment Module: Matcha Raw Overlay Core\nTheme Profile: Deep Velvet Purple Accent Edition"
        UtilityStaticText.Position = Vector2.new(MenuX + 25, MenuY + HeaderHeight + 25)
        UtilityStaticText.Visible = true
    end
end

