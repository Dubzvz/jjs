local f1PressedState = false
local windowHidden = false

RunService.RenderStepped:Connect(function()
    if typeof(iskeypressed) == "function" and typeof(isrbxactive) == "function" then
        if isrbxactive() then
            -- 0x70 points directly to Windows Virtual Hardware Key Code for F1
            if iskeypressed(0x70) then
                if not f1PressedState then
                    windowHidden = not windowHidden
                    MainFrame.Visible = not windowHidden
                    f1PressedState = true
                end
            else
                f1PressedState = false
            end
        end
    end
end)

--------------------------------------------------------------
-- BACKGROUND REMOTES AUTOMATION LOOPS
--------------------------------------------------------------
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function findRemote(name)
    local items = ReplicatedStorage:GetDescendants()
    for i = 1, #items do
        local v = items[i]
        if v:IsA("RemoteEvent") and string.find(string.lower(v.Name), string.lower(name)) then 
            return v 
        end
    end
    return nil
end

local function runQTEAutomation()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    
    local guiItems = pg:GetDescendants()
    for i = 1, #guiItems do
        local v = guiItems[i]
        if v:IsA("TextButton") or v:IsA("ImageButton") then
            local name = string.lower(v.Name)
            if string.find(name, "qte") or string.find(name, "hit") or string.find(name, "prompt") or string.find(name, "attorney") then
                if v.Visible then
                    local remote = findRemote("qte") or findRemote("attorney")
                    if remote then remote:FireServer("Success", true) end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        if Toggles.DefenseAttorneyQTE or Toggles.CharaAutoQTE then runQTEAutomation() end
        if Toggles.NanamiAutoRatio then
            local remote = findRemote("ratio") or findRemote("nanami")
            if remote then remote:FireServer("Ratio", true) end
        end
        if Toggles.TodoAutoPerfectSwap then
            local remote = findRemote("swap") or findRemote("todo")
            if remote then remote:FireServer("PerfectSwap", true) end
        end
        if Toggles.AutoBlock then
            local remote = findRemote("block") or findRemote("guard")
            if remote then remote:FireServer(true) end
        end
    end)
end)

--------------------------------------------------------------
-- BILLBOARD CORE OVERLAY HIGHLIGHT ESP GENERATOR
--------------------------------------------------------------
local CachedTargets = {}

task.spawn(function()
    while true do
        local tempCache = {}
        local allObjects = Workspace:GetDescendants()
        
        for i = 1, #allObjects do
            local obj = allObjects[i]
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local nameLower = string.lower(obj.Name)
                local parentNameLower = obj.Parent and string.lower(obj.Parent.Name) or ""
                
                local isDummy = string.find(nameLower, "dummy") or string.find(parentNameLower, "dummy")
                local isItem = obj:IsA("Tool") or string.find(nameLower, "pickup") or string.find(nameLower, "cursed")
                local isDomain = string.find(nameLower, "domain")
                
                if isDummy or isItem or isDomain then
                    local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart") or (obj:IsA("BasePart") and obj)
                    if hrp then
                        table.insert(tempCache, {
                            instance = obj,
                            hrp = hrp,
                            type = isDummy and "dummy" or (isDomain and "domain" or "item")
                        })
                    end
                end
            end
        end
        
        CachedTargets = tempCache
        task.wait(1.5)
    end
end)

RunService.RenderStepped:Connect(function()
    local myHrp = getHRP()
    local oldTags = Workspace:FindFirstChild("MatchaClickESPRender")
    if oldTags then oldTags:Destroy() end

    if not (Toggles.ItemsESP or Toggles.DummyESP or Toggles.DomainHealthESP) then return end

    local renderGroup = TargetInstance.new("Folder")
    renderGroup.Name = "MatchaClickESPRender"
    renderGroup.Parent = Workspace

    for i = 1, #CachedTargets do
        local cache = CachedTargets[i]
        if not cache.instance or not cache.instance.Parent then continue end
        if cache.instance == LP.Character or cache.instance.Parent == LP.Character then continue end

        local renderEnabled = false
        if cache.type == "dummy" and Toggles.DummyESP then renderEnabled = true
        elseif cache.type == "item" and Toggles.ItemsESP then renderEnabled = true
        elseif cache.type == "domain" and Toggles.DomainHealthESP then renderEnabled = true end

        if renderEnabled then
            local dist = myHrp and math.floor((myHrp.Position - cache.hrp.Position).Magnitude) or 0
            
            local bb = TargetInstance.new("BillboardGui")
            bb.Size = UDim2.new(0, 200, 0, 50)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 1000
            bb.Adornee = cache.hrp
            bb.Parent = renderGroup

            local tl = TargetInstance.new("TextLabel")
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.Text = cache.instance.Name .. " [" .. dist .. "m]"
            tl.Font = Enum.Font.GothamBold
            tl.TextSize = 11
            tl.TextStrokeTransparency = 0
            
            if cache.type == "dummy" then
                tl.TextColor3 = Color3.fromRGB(255, 90, 90)
            elseif cache.type == "domain" then
                tl.TextColor3 = Color3.fromRGB(230, 80, 230)
            else
                tl.TextColor3 = Color3.fromRGB(140, 80, 240) -- Matching Velvet Purple Theme Line
            end
            tl.Parent = bb
        end
    end
end)
