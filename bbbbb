-- 1. Game Environment Recovery & Safety Boot Loop
local GameEnv = getfenv(0)
local TargetInstance = GameEnv.Instance or Instance

if not TargetInstance or type(TargetInstance.new) ~= "function" then
    if typeof(notify) == "function" then
        notify("Failed to link with game environment memory.", "Matcha Error", 5)
    end
    return
end

local MainGame = game
local GetService = MainGame.GetService
local Players = GetService(MainGame, "Players")
local LP = Players.LocalPlayer

-- Wait for the PlayerGui layer to be fully instantiated by the engine
local CoreGui = nil
while not CoreGui do
    task.wait(0.5)
    pcall(function()
        CoreGui = LP:FindFirstChildWhichIsA("PlayerGui") or GetService(MainGame, "CoreGui")
    end)
end

local ReplicatedStorage = GetService(MainGame, "ReplicatedStorage")
local Workspace = GetService(MainGame, "Workspace")
local RunService = GetService(MainGame, "RunService")

-- Native Matcha API Execution Notification
if typeof(notify) == "function" then
    notify("Loaded ClickGUI Layout Successfully", "Matcha Engine", 4)
end

-- Clear old interface frames left over from previous execution loops
local oldUI = CoreGui:FindFirstChild("MatchaJJSPurpleClick")
if oldUI then oldUI:Destroy() end

-- Enable hardware external inputs
if typeof(setrobloxinput) == "function" then
    setrobloxinput(true)
end

