local function createTabFrame(tabName, layoutOrder)
    local page = TargetInstance.new("ScrollingFrame")
    page.Name = tabName .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticCanvasSize.Y
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(130, 80, 240)
    page.Visible = false
    page.Parent = PagesContainer
    
    local pageLayout = TargetInstance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.Parent = page

    -- Build Navigational Category Selector Button
    local btn = TargetInstance.new("TextButton")
    btn.Name = tabName .. "Tab"
    btn.Size = UDim2.new(0, 95, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    btn.Text = tabName
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = Color3.fromRGB(140, 140, 150)
    btn.BorderSizePixel = 0
    btn.LayoutOrder = layoutOrder
    btn.Parent = TabBar

    local btnCorner = TargetInstance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local btnStroke = TargetInstance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(40, 40, 52)
    btnStroke.Thickness = 1
    btnStroke.Parent = btn

    Pages[tabName] = page
    TabButtons[tabName] = {btn = btn, stroke = btnStroke}
end

-- Initialize Categorized Grid Arrays
createTabFrame("MAIN", 1)
createTabFrame("VISUALS", 2)
createTabFrame("SETTINGS", 3)

local function changeActiveTab(tabName)
    for name, page in pairs(Pages) do
        page.Visible = (name == tabName)
        local assets = TabButtons[name]
        if name == tabName then
            assets.btn.BackgroundColor3 = Color3.fromRGB(36, 26, 56)
            assets.btn.TextColor3 = Color3.fromRGB(220, 190, 255)
            assets.stroke.Color = Color3.fromRGB(130, 80, 240)
        else
            assets.btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
            assets.btn.TextColor3 = Color3.fromRGB(140, 140, 150)
            assets.stroke.Color = Color3.fromRGB(35, 35, 45)
        end
    end
end

for name, assets in pairs(TabButtons) do
    assets.btn.MouseButton1Click:Connect(function()
        changeActiveTab(name)
    end)
end
changeActiveTab("MAIN") -- Set initial landing view tab

