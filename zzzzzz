local function changeActiveTab(tabName)
    for name, page in pairs(Pages) do
        page.Visible = (name == tabName)
        local assets = TabButtons[name]
        if name == tabName then
            assets.btn.BackgroundColor3 = Color3.fromRGB(36, 26, 56)
            assets.btn.TextColor3 = Color3.fromRGB(220, 190, 255)
            assets.stroke.Color = Color3.fromRGB(130, 80, 240)
        else
            assets.btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
            assets.btn.TextColor3 = Color3.fromRGB(140, 140, 150)
            assets.stroke.Color = Color3.fromRGB(35, 35, 45)
        end
    end
end

for name, assets in pairs(TabButtons) do
    assets.btn.MouseButton1Click:Connect(function()
        changeActiveTab(name)
    end)
end
