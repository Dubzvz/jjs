local function addToggleCheckbox(targetCategory, mapKey, displayTitle)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -10, 0, 24)
    row.BackgroundTransparency = 1
    row.Parent = targetCategory

    local cBox = Instance.new("TextButton")
