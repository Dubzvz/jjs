local f1PressedState = false
local windowHidden = false

RunService.RenderStepped:Connect(function()
    -- Safely execute checks only if Matcha's native input monitoring api is online
    if typeof(iskeypressed) == "function" and typeof(isrbxactive) == "function" then
        if isrbxactive() then
            -- 0x70 is the Windows Virtual Key Code code for F1
            if iskeypressed(0x70) then
                if not f1PressedState then
                    windowHidden = not windowHidden
                    MainFrame.Visible = not windowHidden
                    f1PressedState = true
                end
            else
                f1PressedState = false
            end
        end
    end
end)

