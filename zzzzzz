    cBox.BorderSizePixel = 0
    cBox.Parent = row

    local cBoxCorner = Instance.new("UICorner")
    cBoxCorner.CornerRadius = UDim.new(0, 4)
    cBoxCorner.Parent = cBox

    local cBoxStroke = Instance.new("UIStroke")
    cBoxStroke.Color = Color3.fromRGB(55, 55, 75)
    cBoxStroke.Thickness = 1
    cBoxStroke.Parent = cBox

    local internalMark = Instance.new("Frame")
    internalMark.Size = UDim2.new(0, 10, 0, 10)
    internalMark.Position = UDim2.new(0.5, -5, 0.5, -5)
    internalMark.BackgroundColor3 = Color3.fromRGB(130, 80, 240)
    internalMark.BorderSizePixel = 0
    internalMark.Visible = false
    internalMark.Parent = cBox

    local markCorner = Instance.new("UICorner")
    markCorner.CornerRadius = UDim.new(0, 2)
    markCorner.Parent = internalMark

    local labelTextButton = Instance.new("TextButton")
    labelTextButton.Size = UDim2.new(1, -26, 1, 0)
    labelTextButton.Position = UDim2.new(0, 26, 0, 0)
    labelTextButton.BackgroundTransparency = 1
    labelTextButton.Text = displayTitle
    labelTextButton.Font = Enum.Font.GothamMedium
    labelTextButton.TextSize = 13
    labelTextButton.TextColor3 = Color3.fromRGB(175, 175, 185)
    labelTextButton.TextXAlignment = Enum.TextXAlignment.Left
    labelTextButton.Parent = row

    local function applyVisualChange()
        internalMark.Visible = Toggles[mapKey]
        if Toggles[mapKey] then
            cBoxStroke.Color = Color3.fromRGB(130, 80, 240)
            labelTextButton.TextColor3 = Color3.fromRGB(225, 210, 255)
        else
            cBoxStroke.Color = Color3.fromRGB(55, 55, 75)
            labelTextButton.TextColor3 = Color3.fromRGB(175, 175, 185)
        end
    end

    local function clicked()
        Toggles[mapKey] = not Toggles[mapKey]
        applyVisualChange()
    end

    cBox.MouseButton1Click:Connect(clicked)
    labelTextButton.MouseButton1Click:Connect(clicked)
end

