-- ============================================================
-- UTIL
-- ============================================================
local function lower(s) return string.lower(tostring(s or "")) end

local function contains_any(haystack, list)
    local h = lower(haystack)
    for _, n in ipairs(list) do
        if string.find(h, n, 1, true) then return true end
    end
    return false
end

local function in_rect(px, py, x, y, w, h)
    return px >= x and px <= x + w and py >= y and py <= y + h
end

local function safe_get_root(plr)
    local c = plr and plr.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
end

local function distance_from_local(pos)
    local root = safe_get_root(LocalPlayer)
    if not root then return math.huge end
    local d = root.Position - pos
    return math.sqrt(d.X*d.X + d.Y*d.Y + d.Z*d.Z)
end

local function tap_key(vk)
    keypress(vk); task.wait(0.02); keyrelease(vk)
    if Cfg.QTEDoubleTap then
        task.wait(0.05); keypress(vk); task.wait(0.02); keyrelease(vk)
    end
end

-- ============================================================
-- MODEL BOUNDS  (walks every BasePart for a real AABB)
-- ============================================================
local function model_aabb(inst)
    if inst:IsA("BasePart") then
        return inst.Position, inst.Size
    end
    local minX, minY, minZ =  math.huge,  math.huge,  math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local found = false
    local kids = inst:GetDescendants()
    for _, p in ipairs(kids) do
        if p:IsA("BasePart") then
            local pos, sz = p.Position, p.Size
            local hx, hy, hz = sz.X*0.5, sz.Y*0.5, sz.Z*0.5
            if pos.X-hx < minX then minX = pos.X-hx end
            if pos.Y-hy < minY then minY = pos.Y-hy end
            if pos.Z-hz < minZ then minZ = pos.Z-hz end
            if pos.X+hx > maxX then maxX = pos.X+hx end
            if pos.Y+hy > maxY then maxY = pos.Y+hy end
            if pos.Z+hz > maxZ then maxZ = pos.Z+hz end
            found = true
        end
    end
    if not found then return nil, nil end
    local center = Vector3.new((minX+maxX)*0.5, (minY+maxY)*0.5, (minZ+maxZ)*0.5)
    local size   = Vector3.new(maxX-minX, maxY-minY, maxZ-minZ)
    return center, size
end

local function project_aabb(center, size)
    local hx, hy, hz = size.X*0.5, size.Y*0.5, size.Z*0.5
    local offsets = {
        Vector3.new(-hx,-hy,-hz),Vector3.new( hx,-hy,-hz),
        Vector3.new(-hx, hy,-hz),Vector3.new( hx, hy,-hz),
        Vector3.new(-hx,-hy, hz),Vector3.new( hx,-hy, hz),
        Vector3.new(-hx, hy, hz),Vector3.new( hx, hy, hz),
    }
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local any_on = false
    for _, off in ipairs(offsets) do
        local sp, on = WorldToScreen(Vector3.new(center.X+off.X, center.Y+off.Y, center.Z+off.Z))
        if sp then
            if sp.X < minX then minX = sp.X end
            if sp.Y < minY then minY = sp.Y end
            if sp.X > maxX then maxX = sp.X end
            if sp.Y > maxY then maxY = sp.Y end
            if on then any_on = true end
        end
    end
    if not any_on or minX == math.huge then return nil end
    local w = math.max(8, maxX - minX)
    local h = math.max(8, maxY - minY)
    return minX, minY, w, h
end

