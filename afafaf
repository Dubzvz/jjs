local function createTab(tabName, layoutOrder)
    -- Page view container
    local page = Instance.new("ScrollingFrame")
    page.Name = tabName .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticCanvasSize.Y
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Color3.fromRGB(130, 70, 220)
    page.Visible = false
    page.Parent = PagesContainer
    
    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingTop = UDim.new(0, 5)
    pagePadding.PaddingLeft = UDim.new(0, 5)
    pagePadding.Parent = page

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.Parent = page

    -- Navigation bar button
    local btn = Instance.new("TextButton")
    btn.Name = tabName .. "Tab"
    btn.Size = UDim2.new(0, 100, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    btn.Text = tabName
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.TextColor3 = Color3.fromRGB(160, 160, 170)
    btn.BorderSizePixel = 0
    btn.LayoutOrder = layoutOrder
    btn.Parent = TabBar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(45, 45, 60)
    btnStroke.Thickness = 1
    btnStroke.Parent = btn

    Pages[tabName] = page
    TabButtons[tabName] = {btn = btn, stroke = btnStroke}
end

createTab("MAIN", 1)
createTab("VISUALS", 2)
createTab("SETTINGS", 3)
createTab("ABOUT", 4)

local function switchTab(tabName)
    currentTab = tabName
    for name, page in pairs(Pages) do
        page.Visible = (name == tabName)
        local tabAssets = TabButtons[name]
        if name == tabName then
            tabAssets.btn.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
            tabAssets.btn.TextColor3 = Color3.fromRGB(220, 180, 255)
            tabAssets.stroke.Color = Color3.fromRGB(130, 70, 220)
        else
            tabAssets.btn.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
            tabAssets.btn.TextColor3 = Color3.fromRGB(150, 150, 160)
            tabAssets.stroke.Color = Color3.fromRGB(40, 40, 50)
        end
    end
end

for name, assets in pairs(TabButtons) do
    assets.btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end
switchTab("MAIN") -- Default startup tab

