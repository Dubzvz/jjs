local function createCheckbox(parentSection, toggleKey, labelText)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -10, 0, 24)
    container.BackgroundTransparency = 1
    container.Parent = parentSection

    local boxButton = Instance.new("TextButton")
    boxButton.Size = UDim2.new(0, 16, 0, 16)
    boxButton.Position = UDim2.new(0, 0, 0.5, -8)
    boxButton.BackgroundColor3 = Color3.fromRGB(32, 32, 44)
    boxButton.Text = ""
    boxButton.BorderSizePixel = 0
    boxButton.Parent = container

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = boxButton

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Color = Color3.fromRGB(60, 60, 80)
    boxStroke.Thickness = 1
    boxStroke.Parent = boxButton

    local checkFill = Instance.new("Frame")
    checkFill.Size = UDim2.new(0, 10, 0, 10)
    checkFill.Position = UDim2.new(0.5, -5, 0.5, -5)
    checkFill.BackgroundColor3 = Color3.fromRGB(140, 80, 240)
    checkFill.BorderSizePixel = 0
    checkFill.Visible = false
    checkFill.Parent = boxButton

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 2)
    fillCorner.Parent = checkFill

    local label = Instance.new("TextButton")
    label.Size = UDim2.new(1, -26, 1, 0)
    label.Position = UDim2.new(0, 26, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextColor3 = Color3.fromRGB(190, 190, 200)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local function updateVisualState()
        checkFill.Visible = Toggles[toggleKey]
        if Toggles[toggleKey] then
            boxStroke.Color = Color3.fromRGB(140, 80, 240)
            label.TextColor3 = Color3.fromRGB(230, 220, 255)
        else
            boxStroke.Color = Color3.fromRGB(60, 60, 80)
            label.TextColor3 = Color3.fromRGB(180, 180, 190)
        end
    end

    local function triggerToggle()
        Toggles[toggleKey] = not Toggles[toggleKey]
        updateVisualState()
    end

    boxButton.MouseButton1Click:Connect(triggerToggle)
    label.MouseButton1Click:Connect(triggerToggle)
end

