-- ============================================================
-- UTIL
-- ============================================================
local function lower(s) return string.lower(tostring(s or "")) end

local function contains_any(haystack, list)
    local h = lower(haystack)
    for _, n in ipairs(list) do
        if string.find(h, n, 1, true) then return true end
    end
    return false
end

local function in_rect(px, py, x, y, w, h)
    return px >= x and px <= x + w and py >= y and py <= y + h
end

local function safe_get_root(plr)
    local c = plr and plr.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or (c.PrimaryPart)
end

local function distance_from_local(pos)
    local root = safe_get_root(LocalPlayer)
    if not root then return math.huge end
    local d = root.Position - pos
    return math.sqrt(d.X*d.X + d.Y*d.Y + d.Z*d.Z)
end

local function tap_key(vk)
    keypress(vk)
    task.wait(0.02)
    keyrelease(vk)
    if Cfg.QTEDoubleTap then
        task.wait(0.05)
        keypress(vk); task.wait(0.02); keyrelease(vk)
    end
end

