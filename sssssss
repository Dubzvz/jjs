-- SAFE INSTANCE CREATION WRAPPER
--------------------------------------------------------------
local function create(className, properties)
    local obj
    local success, err = pcall(function()
        obj = Instance.new(className)
    end)
    
    if not success or not obj then
        pcall(function()
            local coreGui = game:GetService("CoreGui") or LP:WaitForChild("PlayerGui")
            local dummy = coreGui:FindFirstChildOfClass(className)
            if dummy then obj = dummy:Clone() end
        end)
    end
    
    if not obj then
        error("Critical: Environment sandbox blocked object creation for " .. tostring(className))
    end

    if properties then
        for prop, val in pairs(properties) do
            pcall(function()
                obj[prop] = val
            end)
        end
    end
    return obj
end

