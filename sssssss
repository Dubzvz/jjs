local function clearESP(category)
    for _, obj in pairs(ESPObjects[category] or {}) do
        if obj and obj.Parent then pcall(function() obj:Destroy() end) end
    end
    ESPObjects[category] = {}
end

local function getDistance(part)
    local hrp = getHRP()
    if hrp and part then return math.floor((hrp.Position - part.Position).Magnitude) end
    return 0
end

