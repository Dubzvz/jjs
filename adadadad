local function now()
    return os.clock()
end

local function lowerText(value)
    if value == nil then
        return ""
    end
    return string.lower(tostring(value))
end

local function containsAny(text, words)
    text = lowerText(text)
    for _, word in pairs(words) do
        if string.find(text, lowerText(word), 1, true) then
            return true
        end
    end
    return false
end

local function containsAll(text, words)
    text = lowerText(text)
    for _, word in pairs(words) do
        if not string.find(text, lowerText(word), 1, true) then
            return false
        end
    end
    return true
end

local function makeText(text, x, y, color, size)
    local obj = Drawing.new("Text")
    obj.Text = text
    obj.Position = Vector2.new(x, y)
    obj.Color = color
    obj.Transparency = 1
    obj.Outline = true
    obj.Center = false
    obj.Size = size or 15
    obj.Visible = true
    obj.ZIndex = 50
    return obj
end

local function makeSquare(x, y, w, h, color, filled)
    local obj = Drawing.new("Square")
    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Color = color
    obj.Transparency = 1
    obj.Filled = filled
    obj.Visible = true
    obj.ZIndex = 40
    return obj
end

local function addDrawing(obj)
    State.Drawings[#State.Drawings + 1] = obj
    return obj
end

local function addOverlayDrawing(obj)
    State.OverlayDrawings[#State.OverlayDrawings + 1] = obj
    return obj
end

local function clearOverlay()
    for _, obj in pairs(State.OverlayDrawings) do
        pcall(function()
            obj:Remove()
        end)
    end
    State.OverlayDrawings = {}
end

local function getCharacter()
    if LocalPlayer then
        return LocalPlayer.Character
    end
    return nil
end

local function getRoot(model)
    if not model then
        return nil
    end

    local primary = model.PrimaryPart
    if primary then
        return primary
    end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp then
        return hrp
    end

    local torso = model:FindFirstChild("Torso")
    if torso then
        return torso
    end

    local head = model:FindFirstChild("Head")
    if head then
        return head
    end

    return nil
end

local function getDistance(part)
    local char = getCharacter()
    local root = getRoot(char)

    if not root or not part then
        return 0
    end

    local dx = root.Position.X - part.Position.X
    local dy = root.Position.Y - part.Position.Y
    local dz = root.Position.Z - part.Position.Z

    return math.sqrt((dx * dx) + (dy * dy) + (dz * dz))
end

local function getHumanoid(model)
    if not model then
        return nil
    end
    return model:FindFirstChildOfClass("Humanoid")
end

local function isAliveModel(model)
    local hum = getHumanoid(model)
    if hum and hum.Health <= 0 then
        return false
    end
    return true
end

local ESP = {}
ESP.__index = ESP
ESP.WS = Workspace

ESP.Config = {
    RenderSettings = {
        Type = "RunService"
    },
    Text = {
        TextFont = Drawing.Fonts.SystemBold,
        DefColor = Color3.new(1, 1, 1),
        DefText = "ESP",
        ZIndex = 50
    }
}

ESP.Act = false
ESP.CActive = {}
ESP.RS = nil

function ESP:Render()
    for address, data in pairs(self.CActive) do
        if not data or not data.Instance or not data.Instance:IsDescendantOf(self.WS) then
            self:DeleteESP("M", address)
        else
            local ok, pos = pcall(function()
                return data.Instance.Position
            end)

            if not ok or not pos then
                self:DeleteESP("M", address)
            else
                local screenPos, onScreen = WorldToScreen(pos)

                if onScreen then
                    local distance = getDistance(data.Instance)

                    if distance > CONFIG.EspMaxDistance then
                        data.ESP.Visible = false
                    else
                        data.ESP.Visible = true
                        data.ESP.Position = screenPos

                        if data.BaseText then
                            data.ESP.Text = data.BaseText .. " [" .. tostring(math.floor(distance)) .. "m]"
                        end
                    end
                else
                    data.ESP.Visible = false
                end
            end
        end
    end
end

function ESP:CreateRenderFlow()
    if self.Act then
        return
    end

    self.Act = true

    if self.Config.RenderSettings.Type:lower() == "runservice" then
        self.RS = RunService.RenderStepped:Connect(function()
            self:Render()
        end)
    else
        task.spawn(function()
            while self.Act do
                self:Render()
                task.wait()
            end
        end)
    end
end

function ESP:CreateESP(obj, text, color, espType)
    if not obj or not obj.Address then
        return
    end

    self:CreateRenderFlow()

    if self.CActive[obj.Address] then
        self:UpdateESP(obj, text, color)
        return
    end

    local drawing = Drawing.new("Text")
    drawing.Outline = true
    drawing.Center = true
    drawing.Visible = false
    drawing.Color = color or self.Config.Text.DefColor
    drawing.Text = text or self.Config.Text.DefText
    drawing.Font = self.Config.Text.TextFont
    drawing.ZIndex = self.Config.Text.ZIndex
    drawing.Size = 14

    self.CActive[obj.Address] = {
        Instance = obj,
        Type = espType or "Default",
        ESP = drawing,
        BaseText = text or self.Config.Text.DefText
    }
end

function ESP:UpdateESP(linked, text, color)
    if not linked or not linked.Address then
        return
    end

    local data = self.CActive[linked.Address]
    if not data then
        return
    end

    if text then
        data.BaseText = text
        data.ESP.Text = text
    end

    if color then
        data.ESP.Color = color
    end
end

function ESP:DeleteESP(mode, link)
    mode = lowerText(mode)

    if mode == "m" then
        local address = link

        if type(link) == "table" and link.Address then
            address = link.Address
        end

        local data = self.CActive[address]
        if not data then
            return
        end

        if data.ESP then
            data.ESP:Remove()
        end

        self.CActive[address] = nil
        return
    end

    if mode == "t" then
        for address, data in pairs(self.CActive) do
            if data and data.Type == link then
                if data.ESP then
                    data.ESP:Remove()
                end

                self.CActive[address] = nil
            end
        end
    end
end

function ESP:End()
    self.Act = false

    if self.RS then
        self.RS:Disconnect()
        self.RS = nil
    end

    for address, data in pairs(self.CActive) do
        if data and data.ESP then
            data.ESP:Remove()
        end
        self.CActive[address] = nil
    end

    self.CActive = {}
end

_G.EModule = ESP

local function clearEsp()
    ESP:DeleteESP("t", "Items")
    ESP:DeleteESP("t", "Dummies")
    ESP:DeleteESP("t", "Domains")
end

local function isDummyModel(inst)
    if not inst or not inst:IsA("Model") then
        return false
    end

    local name = lowerText(inst.Name)

    if string.find(name, "dummy", 1, true) or string.find(name, "training", 1, true) or string.find(name, "npc", 1, true) then
        return getRoot(inst) ~= nil
    end

    if getHumanoid(inst) and getRoot(inst) then
        return containsAny(name, { "dummy", "npc", "mob", "enemy", "boss" })
    end

    return false
end

local function isItem(inst)
    if not inst then
        return false
    end

    local name = lowerText(inst.Name)
    local className = lowerText(inst.ClassName)

    if string.find(className, "tool", 1, true) then
        return true
    end

    return containsAny(name, { "item", "drop", "weapon", "finger", "scroll", "katana", "sword", "cursed", "object" })
end

local function isDomainObject(inst)
    if not inst then
        return false
    end

    local name = lowerText(inst.Name)
    return containsAny(name, { "domain", "barrier", "shrine", "void", "expansion", "health" })
end

local function findHealthText(inst)
    local health = nil

    pcall(function()
        local hum = getHumanoid(inst)
        if hum then
            health = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
        end
    end)

    if health then
        return health
    end

    pcall(function()
        local attr = inst:GetAttribute("Health")
        local maxAttr = inst:GetAttribute("MaxHealth")
        if attr then
            if maxAttr then
                health = tostring(attr) .. "/" .. tostring(maxAttr)
            else
                health = tostring(attr)
            end
        end
    end)

    if health then
        return health
    end

    pcall(function()
        local child = inst:FindFirstChild("Health")
        if child and child.Value ~= nil then
            health = tostring(child.Value)
        end
    end)

    return health or "?"
end

local function scanEspTargets()
    if not State.Toggles.ItemsESP then
        ESP:DeleteESP("t", "Items")
    end

    if not State.Toggles.DummyESP then
        ESP:DeleteESP("t", "Dummies")
    end

    if not State.Toggles.DomainHealthESP then
        ESP:DeleteESP("t", "Domains")
    end

    if not State.Toggles.ItemsESP and not State.Toggles.DummyESP and not State.Toggles.DomainHealthESP then
        return
    end

    local descendants = game:GetDescendants()

    for _, inst in pairs(descendants) do
        if State.Toggles.ItemsESP and isItem(inst) then
            local part = nil

            if inst:IsA("Model") then
                part = getRoot(inst)
            elseif inst:IsA("BasePart") or inst:IsA("MeshPart") then
                part = inst
            end

            if part and getDistance(part) <= CONFIG.EspMaxDistance then
                ESP:CreateESP(part, "[ITEM] " .. inst.Name, CONFIG.Colors.Item, "Items")
            end
        end

        if State.Toggles.DummyESP and isDummyModel(inst) and isAliveModel(inst) then
            local part = getRoot(inst)

            if part and getDistance(part) <= CONFIG.EspMaxDistance then
                local hum = getHumanoid(inst)
                local hp = ""

                if hum then
                    hp = " HP:" .. tostring(math.floor(hum.Health))
                end

                ESP:CreateESP(part, "[DUMMY] " .. inst.Name .. hp, CONFIG.Colors.Dummy, "Dummies")
            end
        end

        if State.Toggles.DomainHealthESP and isDomainObject(inst) then
            local part = nil

            if inst:IsA("Model") then
                part = getRoot(inst)
            elseif inst:IsA("BasePart") or inst:IsA("MeshPart") then
                part = inst
            end

            if part and getDistance(part) <= CONFIG.EspMaxDistance then
                ESP:CreateESP(part, "[DOMAIN] " .. inst.Name .. " HP:" .. findHealthText(inst), CONFIG.Colors.Domain, "Domains")
            end
        end
    end
end

local function createMenu()
    local x = 35
    local y = 120
    local w = 285
    local headerH = 32
    local rowH = 25
    local h = headerH + (#FeatureRows * rowH) + 12

    addDrawing(makeSquare(x, y, w, h, CONFIG.Colors.MenuBg, true))
    addDrawing(makeSquare(x, y, w, headerH, CONFIG.Colors.MenuHeader, true))
    addDrawing(makeText("JJS Matcha Helper", x + 10, y + 8, CONFIG.Colors.MenuText, 16))

    for i, row in pairs(FeatureRows) do
        local rowY = y + headerH + ((i - 1) * rowH) + 6
        local box = addDrawing(makeSquare(x + 10, rowY + 3, 13, 13, CONFIG.Colors.Disabled, true))
        local label = addDrawing(makeText(row.Label, x + 32, rowY, CONFIG.Colors.MenuText, 14))

        row.Box = box
        row.Text = label
        row.X = x
        row.Y = rowY
        row.W = w
        row.H = rowH
    end
end

local function updateMenu()
    for _, obj in pairs(State.Drawings) do
        obj.Visible = State.MenuVisible
    end

    for _, row in pairs(FeatureRows) do
        if State.Toggles[row.Key] then
            row.Box.Color = CONFIG.Colors.Enabled
        else
            row.Box.Color = CONFIG.Colors.Disabled
        end
    end
end

local function mouseIn(x, y, w, h, mx, my)
    return mx >= x and mx <= x + w and my >= y and my <= y + h
end

local function handleMenuInput()
    local menuKeyDown = iskeypressed(CONFIG.MenuKey)

    if menuKeyDown and not State.LastMenuKey then
        State.MenuVisible = not State.MenuVisible
        updateMenu()
    end

    State.LastMenuKey = menuKeyDown

    local clickDown = ismouse1pressed()

    if not State.MenuVisible then
        State.LastClick = clickDown
        return
    end

    if clickDown and not State.LastClick and now() - State.LastClickTime >= CONFIG.ClickDebounce then
        State.LastClickTime = now()

        local mouse = LocalPlayer:GetMouse()
        local mx = mouse.X
        local my = mouse.Y

        for _, row in pairs(FeatureRows) do
            if mouseIn(row.X, row.Y, row.W, row.H, mx, my) then
                State.Toggles[row.Key] = not State.Toggles[row.Key]
                updateMenu()

                notify(row.Label .. ": " .. tostring(State.Toggles[row.Key]), "JJS Helper", 1.5)

                if row.Key == "ItemsESP" or row.Key == "DummyESP" or row.Key == "DomainHealthESP" then
                    clearEsp()
                    LastEspScan = 0
                end

                if row.Key == "HiromiVoteTracker" then
                    clearOverlay()
                    LastVoteScan = 0
                end

                break
            end
        end
    end

    State.LastClick = clickDown
end

local function readAllTextLabels()
    local labels = {}
    local descendants = game:GetDescendants()

    for _, inst in pairs(descendants) do
        if inst:IsA("TextLabel") then
            local ok, text = pcall(function()
                return inst.Text
            end)

            if ok and text and text ~= "" then
                labels[#labels + 1] = {
                    Instance = inst,
                    Text = tostring(text)
                }
            end
        end
    end

    return labels
end

local function extractKeyFromText(text, fallback)
    local upper = string.upper(tostring(text))

    for name, code in pairs(KEY_NAME_TO_CODE) do
        if string.find(upper, "[" .. name .. "]", 1, true) then
            return code
        end

        if string.find(upper, " " .. name .. " ", 1, true) then
            return code
        end

        if string.find(upper, "PRESS " .. name, 1, true) then
            return code
        end
    end

    if string.find(upper, "SPACE", 1, true) then
        return KEY_NAME_TO_CODE.SPACE
    end

    return fallback
end

local function tapKey(keyCode)
    keypress(keyCode)
    wait(CONFIG.AutoQteDelay)
    keyrelease(keyCode)
end

local function tryQte(name, qteConfig)
    if now() - (State.LastQtePress[name] or 0) < CONFIG.AutoQteCooldown then
        return
    end

    local labels = readAllTextLabels()

    for _, label in pairs(labels) do
        if containsAll(label.Text, qteConfig.Keywords) or containsAny(label.Text, qteConfig.Keywords) then
            local keyCode = extractKeyFromText(label.Text, qteConfig.DefaultKey)
            State.LastQtePress[name] = now()
            tapKey(keyCode)
            notify("Pressed QTE key for " .. name, "JJS Helper", 1)
            return
        end
    end
end

local function updateQteHelpers()
    if State.Toggles.DefenseAttorneyQTE then
        tryQte("Defense Attorney", CONFIG.QTE.DefenseAttorney)
    end

    if State.Toggles.NanamiAutoRatio then
        tryQte("Nanami Ratio", CONFIG.QTE.NanamiRatio)
    end

    if State.Toggles.TodoAutoPerfectSwap then
        tryQte("Todo Perfect Swap", CONFIG.QTE.TodoPerfectSwap)
    end

    if State.Toggles.CharaAutoCharaQTE then
        tryQte("Chara QTE", CONFIG.QTE.CharaQTE)
    end
end

local function updateVoteTracker()
    clearOverlay()

    if not State.Toggles.HiromiVoteTracker then
        return
    end

    local labels = readAllTextLabels()
    local found = {}

    for _, label in pairs(labels) do
        local text = label.Text
        local low = lowerText(text)

        if containsAny(low, { "hiromi", "vote", "guilty", "innocent", "judgement", "judge" }) then
            found[#found + 1] = text
        end
    end

    if #found > 0 then
        local camera = Workspace.CurrentCamera
        local viewport = camera.ViewportSize

        addOverlayDrawing(makeSquare(viewport.X - 330, 115, 300, 28 + (#found * 18), CONFIG.Colors.MenuBg, true))
        addOverlayDrawing(makeText("HIROMI VOTE TRACKER", viewport.X - 320, 122, CONFIG.Colors.Vote, 14))

        for i, text in pairs(found) do
            addOverlayDrawing(makeText(tostring(text), viewport.X - 320, 142 + (i * 18), CONFIG.Colors.Vote, 13))
        end
    end
end

local function cleanup()
    State.Running = false

    if MainRenderConnection then
        pcall(function()
            MainRenderConnection:Disconnect()
        end)
        MainRenderConnection = nil
    end

    clearEsp()
    ESP:End()
    clearOverlay()

    for _, obj in pairs(State.Drawings) do
        pcall(function()
            obj:Remove()
        end)
    end

    State.Drawings = {}

    notify("JJS Matcha Helper unloaded", "JJS Helper", 2)
end

_G.__JJS_MATCHA_HELPER_CLEANUP = cleanup

