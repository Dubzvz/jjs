updateMenu()

notify("Loaded. Press INSERT for menu.", "JJS Matcha Helper", 3)
print("JJS Matcha Helper loaded. Press INSERT to toggle menu.")

MainRenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    if not State.Running then
        return
    end

    pcall(function()
        handleMenuInput()
        updateMenu()

        local t = now()

        if t - LastEspScan >= CONFIG.EspScanDelay then
            LastEspScan = t
            scanEspTargets()
        end

        if t - LastVoteScan >= CONFIG.VoteScanDelay then
            LastVoteScan = t
            updateVoteTracker()
        end

        if t - LastQteUpdate >= CONFIG.ScanDelay then
            LastQteUpdate = t
            updateQteHelpers()
        end
    end)
end)
