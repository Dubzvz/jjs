--[[
    JJS Matcha LuaVM Helper
    Matcha-only standalone script.

    Controls:
    - INSERT: show / hide menu
    - Left click menu rows: toggle features

    Notes:
    - Uses only Matcha-style APIs from the docs you pasted.
    - QTE helpers scan visible/readable TextLabel text and press configured keys.
    - ESP uses Drawing + WorldToScreen.
    - ESP/menu update through RunService.RenderStepped.
]]

local CONFIG = {
    MenuKey = 0x2D, -- INSERT
    ClickDebounce = 0.20,

    ScanDelay = 0.25,
    EspRefreshDelay = 0.05,
    EspMaxDistance = 3000,

    AutoQteDelay = 0.08,
    AutoQteCooldown = 0.35,

    Colors = {
        MenuBg = Color3.fromRGB(18, 18, 22),
        MenuHeader = Color3.fromRGB(42, 80, 160),
        MenuText = Color3.fromRGB(235, 235, 235),
        Enabled = Color3.fromRGB(80, 230, 130),
        Disabled = Color3.fromRGB(230, 90, 90),

        Item = Color3.fromRGB(255, 210, 80),
        Dummy = Color3.fromRGB(120, 210, 255),
        Domain = Color3.fromRGB(210, 120, 255),
        Vote = Color3.fromRGB(255, 255, 255),
    },

    QTE = {
        DefenseAttorney = {
            Keywords = { "defense", "attorney", "qte", "press" },
            DefaultKey = 0x51, -- Q
        },

        NanamiRatio = {
            Keywords = { "ratio", "nanami", "7:3", "weak point", "press" },
            DefaultKey = 0x45, -- E
        },

        TodoPerfectSwap = {
            Keywords = { "perfect swap", "todo", "swap", "clap", "press" },
            DefaultKey = 0x52, -- R
        },

        CharaQTE = {
            Keywords = { "chara", "qte", "slash", "press" },
            DefaultKey = 0x46, -- F
        },
    }
}

local KEY_NAME_TO_CODE = {
    Q = 0x51,
    W = 0x57,
    E = 0x45,
    R = 0x52,
    T = 0x54,
    Y = 0x59,
    U = 0x55,
    A = 0x41,
    S = 0x53,
    D = 0x44,
    F = 0x46,
    G = 0x47,
    H = 0x48,
    J = 0x4A,
    K = 0x4B,
    L = 0x4C,
    Z = 0x5A,
    X = 0x58,
    C = 0x43,
    V = 0x56,
    B = 0x42,
    N = 0x4E,
    M = 0x4D,
    SPACE = 0x20,
}

if _G.__JJS_MATCHA_HELPER_CLEANUP then
    _G.__JJS_MATCHA_HELPER_CLEANUP()
end

local game = game
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local RenderConnection = nil
local LastEspUpdate = 0
local LastQteUpdate = 0

local State = {
    Running = true,
    MenuVisible = true,
    LastMenuKey = false,
    LastClick = false,
    LastClickTime = 0,

    Toggles = {
        DefenseAttorneyQTE = false,
        NanamiAutoRatio = false,
        TodoAutoPerfectSwap = false,
        CharaAutoCharaQTE = false,
        HiromiVoteTracker = true,
        ItemsESP = true,
        DummyESP = true,
        DomainHealthESP = true,
    },

    Drawings = {},
    EspDrawings = {},
    LastQtePress = {},
}

local FeatureRows = {
    { Key = "DefenseAttorneyQTE", Label = "DEFENSE ATTORNEY QTE" },
    { Key = "NanamiAutoRatio", Label = "NANAMI AUTO RATIO" },
    { Key = "TodoAutoPerfectSwap", Label = "TODO AUTO PERFECT SWAP" },
    { Key = "CharaAutoCharaQTE", Label = "CHARA AUTO CHARA QTE" },
    { Key = "HiromiVoteTracker", Label = "HIROMI VOTE TRACKER" },
    { Key = "ItemsESP", Label = "ITEMS ESP" },
    { Key = "DummyESP", Label = "DUMMY ESP" },
    { Key = "DomainHealthESP", Label = "DOMAIN HEALTH ESP" },
}

local function now()
    return os.clock()
end

local function lowerText(value)
    if value == nil then
        return ""
    end
    return string.lower(tostring(value))
end

local function containsAny(text, words)
    text = lowerText(text)
    for _, word in pairs(words) do
        if string.find(text, lowerText(word), 1, true) then
            return true
        end
    end
    return false
end

local function containsAll(text, words)
    text = lowerText(text)
    for _, word in pairs(words) do
        if not string.find(text, lowerText(word), 1, true) then
            return false
        end
    end
    return true
end

local function addDrawing(obj)
    State.Drawings[#State.Drawings + 1] = obj
    return obj
end

local function addEspDrawing(obj)
    State.EspDrawings[#State.EspDrawings + 1] = obj
    return obj
end

local function clearEsp()
    for _, obj in pairs(State.EspDrawings) do
        pcall(function()
            obj:Remove()
        end)
    end
    State.EspDrawings = {}
end

local function makeText(text, x, y, color, size)
    local obj = Drawing.new("Text")
    obj.Text = text
    obj.Position = Vector2.new(x, y)
    obj.Color = color
    obj.Transparency = 1
    obj.Outline = true
    obj.Center = false
    obj.Size = size or 15
    obj.Visible = true
    obj.ZIndex = 50
    return obj
end

local function makeSquare(x, y, w, h, color, filled)
    local obj = Drawing.new("Square")
    obj.Position = Vector2.new(x, y)
    obj.Size = Vector2.new(w, h)
    obj.Color = color
    obj.Transparency = 1
    obj.Filled = filled
    obj.Visible = true
    obj.ZIndex = 40
    return obj
end

local function createMenu()
    local x = 35
    local y = 120
    local w = 285
    local headerH = 32
    local rowH = 25
    local h = headerH + (#FeatureRows * rowH) + 12

    addDrawing(makeSquare(x, y, w, h, CONFIG.Colors.MenuBg, true))
    addDrawing(makeSquare(x, y, w, headerH, CONFIG.Colors.MenuHeader, true))
    addDrawing(makeText("JJS Matcha Helper", x + 10, y + 8, CONFIG.Colors.MenuText, 16))

    for i, row in pairs(FeatureRows) do
        local rowY = y + headerH + ((i - 1) * rowH) + 6
        local box = addDrawing(makeSquare(x + 10, rowY + 3, 13, 13, CONFIG.Colors.Disabled, true))
        local label = addDrawing(makeText(row.Label, x + 32, rowY, CONFIG.Colors.MenuText, 14))
        row.Box = box
        row.Text = label
        row.X = x
        row.Y = rowY
        row.W = w
        row.H = rowH
    end
end

local function updateMenu()
    for _, obj in pairs(State.Drawings) do
        obj.Visible = State.MenuVisible
    end

    for _, row in pairs(FeatureRows) do
        if State.Toggles[row.Key] then
            row.Box.Color = CONFIG.Colors.Enabled
        else
            row.Box.Color = CONFIG.Colors.Disabled
        end
    end
end

local function mouseIn(x, y, w, h, mx, my)
    return mx >= x and mx <= x + w and my >= y and my <= y + h
end

local function handleMenuInput()
    local menuKeyDown = iskeypressed(CONFIG.MenuKey)
    if menuKeyDown and not State.LastMenuKey then
        State.MenuVisible = not State.MenuVisible
        updateMenu()
    end
    State.LastMenuKey = menuKeyDown

    if not State.MenuVisible then
        State.LastClick = ismouse1pressed()
        return
    end

    local clickDown = ismouse1pressed()
    if clickDown and not State.LastClick and now() - State.LastClickTime >= CONFIG.ClickDebounce then
        State.LastClickTime = now()

        local mouse = LocalPlayer:GetMouse()
        local mx = mouse.X
        local my = mouse.Y

        for _, row in pairs(FeatureRows) do
            if mouseIn(row.X, row.Y, row.W, row.H, mx, my) then
                State.Toggles[row.Key] = not State.Toggles[row.Key]
                updateMenu()
                notify(row.Label .. ": " .. tostring(State.Toggles[row.Key]), "JJS Helper", 1.5)
                break
            end
        end
    end

    State.LastClick = clickDown
end

local function getCharacter()
    if LocalPlayer then
        return LocalPlayer.Character
    end
    return nil
end

local function getRoot(model)
    if not model then
        return nil
    end

    local primary = model.PrimaryPart
    if primary then
        return primary
    end

    local hrp = model:FindFirstChild("HumanoidRootPart")
    if hrp then
        return hrp
    end

    local torso = model:FindFirstChild("Torso")
    if torso then
        return torso
    end

    local head = model:FindFirstChild("Head")
    if head then
        return head
    end

    return nil
end

local function getDistance(part)
    local char = getCharacter()
    local root = getRoot(char)
    if not root or not part then
        return 0
    end

    local dx = root.Position.X - part.Position.X
    local dy = root.Position.Y - part.Position.Y
    local dz = root.Position.Z - part.Position.Z
    return math.sqrt((dx * dx) + (dy * dy) + (dz * dz))
end

local function getHumanoid(model)
    if not model then
        return nil
    end
    return model:FindFirstChildOfClass("Humanoid")
end

local function isAliveModel(model)
    local hum = getHumanoid(model)
    if hum and hum.Health <= 0 then
        return false
    end
    return true
end

local function isDummyModel(inst)
    if not inst or not inst:IsA("Model") then
        return false
    end

    local name = lowerText(inst.Name)
    if string.find(name, "dummy", 1, true) or string.find(name, "training", 1, true) or string.find(name, "npc", 1, true) then
        return getRoot(inst) ~= nil
    end

    if getHumanoid(inst) and getRoot(inst) then
        return containsAny(name, { "dummy", "npc", "mob", "enemy", "boss" })
    end

    return false
end

local function isItem(inst)
    if not inst then
        return false
    end

    local name = lowerText(inst.Name)
    local className = lowerText(inst.ClassName)

    if string.find(className, "tool", 1, true) then
        return true
    end

    if containsAny(name, { "item", "drop", "weapon", "finger", "scroll", "katana", "sword", "cursed", "object" }) then
        return true
    end

    return false
end

local function isDomainObject(inst)
    if not inst then
        return false
    end

    local name = lowerText(inst.Name)
    return containsAny(name, { "domain", "barrier", "shrine", "void", "expansion", "health" })
end

local function findHealthText(inst)
    local health = nil

    pcall(function()
        local hum = getHumanoid(inst)
        if hum then
            health = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
        end
    end)

    if health then
        return health
    end

    pcall(function()
        local attr = inst:GetAttribute("Health")
        local maxAttr = inst:GetAttribute("MaxHealth")
        if attr then
            if maxAttr then
                health = tostring(attr) .. "/" .. tostring(maxAttr)
            else
                health = tostring(attr)
            end
        end
    end)

    if health then
        return health
    end

    pcall(function()
        local child = inst:FindFirstChild("Health")
        if child and child.Value ~= nil then
            health = tostring(child.Value)
        end
    end)

    return health or "?"
end

local function drawWorldLabel(part, text, color)
    if not part then
        return
    end

    local distance = getDistance(part)
    if distance > CONFIG.EspMaxDistance then
        return
    end

    local pos, onScreen = WorldToScreen(part.Position)
    if not onScreen then
        return
    end

    local label = makeText(text .. " [" .. tostring(math.floor(distance)) .. "m]", pos.X, pos.Y, color, 14)
    label.Center = true
    addEspDrawing(label)
end

local function updateEsp()
    clearEsp()

    local descendants = game:GetDescendants()

    for _, inst in pairs(descendants) do
        if State.Toggles.ItemsESP and isItem(inst) then
            local part = nil

            if inst:IsA("Model") then
                part = getRoot(inst)
            elseif inst:IsA("BasePart") or inst:IsA("MeshPart") then
                part = inst
            end

            if part then
                drawWorldLabel(part, "[ITEM] " .. inst.Name, CONFIG.Colors.Item)
            end
        end

        if State.Toggles.DummyESP and isDummyModel(inst) and isAliveModel(inst) then
            local part = getRoot(inst)
            if part then
                local hum = getHumanoid(inst)
                local hp = ""
                if hum then
                    hp = " HP:" .. tostring(math.floor(hum.Health))
                end
                drawWorldLabel(part, "[DUMMY] " .. inst.Name .. hp, CONFIG.Colors.Dummy)
            end
        end

        if State.Toggles.DomainHealthESP and isDomainObject(inst) then
            local part = nil

            if inst:IsA("Model") then
                part = getRoot(inst)
            elseif inst:IsA("BasePart") or inst:IsA("MeshPart") then
                part = inst
            end

            if part then
                drawWorldLabel(part, "[DOMAIN] " .. inst.Name .. " HP:" .. findHealthText(inst), CONFIG.Colors.Domain)
            end
        end
    end
end

local function readAllTextLabels()
    local labels = {}
    local descendants = game:GetDescendants()

    for _, inst in pairs(descendants) do
        if inst:IsA("TextLabel") then
            local ok, text = pcall(function()
                return inst.Text
            end)

            if ok and text and text ~= "" then
                labels[#labels + 1] = {
                    Instance = inst,
                    Text = tostring(text)
                }
            end
        end
    end

    return labels
end

local function extractKeyFromText(text, fallback)
    local upper = string.upper(tostring(text))

    for name, code in pairs(KEY_NAME_TO_CODE) do
        if string.find(upper, "[" .. name .. "]", 1, true) then
            return code
        end
        if string.find(upper, " " .. name .. " ", 1, true) then
            return code
        end
        if string.find(upper, "PRESS " .. name, 1, true) then
            return code
        end
    end

    if string.find(upper, "SPACE", 1, true) then
        return KEY_NAME_TO_CODE.SPACE
    end

    return fallback
end

local function tapKey(keyCode)
    keypress(keyCode)
    wait(CONFIG.AutoQteDelay)
    keyrelease(keyCode)
end

local function tryQte(name, qteConfig)
    if now() - (State.LastQtePress[name] or 0) < CONFIG.AutoQteCooldown then
        return
    end

    local labels = readAllTextLabels()

    for _, label in pairs(labels) do
        if containsAll(label.Text, qteConfig.Keywords) or containsAny(label.Text, qteConfig.Keywords) then
            local keyCode = extractKeyFromText(label.Text, qteConfig.DefaultKey)
            State.LastQtePress[name] = now()
            tapKey(keyCode)
            notify("Pressed QTE key for " .. name, "JJS Helper", 1)
            return
        end
    end
end

local function updateQteHelpers()
    if State.Toggles.DefenseAttorneyQTE then
        tryQte("Defense Attorney", CONFIG.QTE.DefenseAttorney)
    end

    if State.Toggles.NanamiAutoRatio then
        tryQte("Nanami Ratio", CONFIG.QTE.NanamiRatio)
    end

    if State.Toggles.TodoAutoPerfectSwap then
        tryQte("Todo Perfect Swap", CONFIG.QTE.TodoPerfectSwap)
    end

    if State.Toggles.CharaAutoCharaQTE then
        tryQte("Chara QTE", CONFIG.QTE.CharaQTE)
    end
end

local function updateVoteTracker()
    if not State.Toggles.HiromiVoteTracker then
        return
    end

    local labels = readAllTextLabels()
    local found = {}

    for _, label in pairs(labels) do
        local text = label.Text
        local low = lowerText(text)

        if containsAny(low, { "hiromi", "vote", "guilty", "innocent", "judgement", "judge" }) then
            found[#found + 1] = text
        end
    end

    if #found > 0 then
        local camera = Workspace.CurrentCamera
        local viewport = camera.ViewportSize

        local bg = makeSquare(viewport.X - 330, 115, 300, 28 + (#found * 18), CONFIG.Colors.MenuBg, true)
        addEspDrawing(bg)

        local title = makeText("HIROMI VOTE TRACKER", viewport.X - 320, 122, CONFIG.Colors.Vote, 14)
        addEspDrawing(title)

        for i, text in pairs(found) do
            local line = makeText(tostring(text), viewport.X - 320, 142 + (i * 18), CONFIG.Colors.Vote, 13)
            addEspDrawing(line)
        end
    end
end

local function cleanup()
    State.Running = false

    if RenderConnection then
        pcall(function()
            RenderConnection:Disconnect()
        end)
        RenderConnection = nil
    end

    clearEsp()

    for _, obj in pairs(State.Drawings) do
        pcall(function()
            obj:Remove()
        end)
    end

    State.Drawings = {}

    notify("JJS Matcha Helper unloaded", "JJS Helper", 2)
end

_G.__JJS_MATCHA_HELPER_CLEANUP = cleanup

createMenu()
updateMenu()

notify("Loaded. Press INSERT for menu.", "JJS Matcha Helper", 3)
print("JJS Matcha Helper loaded. Press INSERT to toggle menu.")

RenderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    if not State.Running then
        return
    end

    pcall(function()
        handleMenuInput()
        updateMenu()

        local t = now()

        if t - LastEspUpdate >= CONFIG.EspRefreshDelay then
            LastEspUpdate = t
            updateEsp()
            updateVoteTracker()
        end

        if t - LastQteUpdate >= CONFIG.ScanDelay then
            LastQteUpdate = t
            updateQteHelpers()
        end
    end)
end)
